<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1F">

    <!-- Glassy Search Bar -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="8dp"
        android:background="@drawable/glass_card_bg">

        <AutoCompleteTextView
            android:id="@+id/sourceInput"
            android:hint="Source"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:padding="10dp"
            android:textSize="16sp"
            android:background="@drawable/rounded_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/ic_source"
            android:drawablePadding="8dp"/>

        <AutoCompleteTextView
            android:id="@+id/destinationInput"
            android:hint="Destination"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:padding="10dp"
            android:textSize="16sp"
            android:background="@drawable/rounded_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/ic_destination"
            android:drawablePadding="8dp"
            android:layout_marginStart="8dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFindRoute"
            android:text="Go"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_blue_glow"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Map Fragment -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_below="@id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartNavigation"
        android:text="Start Navigation"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_blue_glow"
        android:padding="12dp"
        android:elevation="10dp"
        android:visibility="gone"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</RelativeLayout>
