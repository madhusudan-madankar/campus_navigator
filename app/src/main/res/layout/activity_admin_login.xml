<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".admin.AdminLoginActivity">

    <!-- ⭐ VIT LOGO -->
    <ImageView
        android:id="@+id/vitLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/vit_logo"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Page Title -->
    <TextView
        android:id="@+id/tcAdminLoginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Login"
        android:textSize="26sp"
        android:textColor="#00BFFF"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_semi_bold"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/vitLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Admin Icon -->
    <ImageView
        android:id="@+id/imgAdmin"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_admin"
        app:tint="#00BFFF"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/tcAdminLoginTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Admin ID -->
    <EditText
        android:id="@+id/etAdminId"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="Admin ID"
        android:padding="15dp"
        android:textSize="14dp"
        android:background="@drawable/edittext_rounded"
        android:textColor="#FFFFFF"
        android:textColorHint="#80FFFFFF"
        android:inputType="textEmailAddress"
        android:fontFamily="@font/poppins_semi_bold"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/imgAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Password Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/passwordContainer"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/edittext_rounded"
        app:layout_constraintTop_toBottomOf="@id/etAdminId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Password Input -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="Password"
            android:paddingLeft="15dp"
            android:textSize="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:inputType="textPassword"
            android:fontFamily="@font/poppins_semi_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/eyeIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Eye Icon -->
        <ImageView
            android:id="@+id/eyeIcon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_eye"
            app:tint="#80FFFFFF"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Login Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Login"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_rounded_blue"
        android:fontFamily="@font/poppins_semi_bold"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/passwordContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
