<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminDashboard_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    tools:context=".admin.AdminDashboardActivity">

    <!-- ⭐ Added VIT LOGO (Top Center) -->
    <!-- Title -->
    <ImageView
        android:id="@+id/vitLogo"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/vit_logo"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/adminDashboard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/vitLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- Card Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adminDashboard_cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/adminDashboard_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="20dp">

        <!-- Add Location Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/adminDashboard_card_addLocation"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#121212"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/adminDashboard_card_manageConnections"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/adminDashboard_icon_addLocation"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/add_location_ii"
                    app:tint="#03A9F4"
                    />

                <TextView
                    android:id="@+id/adminDashboard_text_addLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Location"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Manage Connections Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/adminDashboard_card_manageConnections"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#121212"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/adminDashboard_card_addLocation"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/adminDashboard_icon_manageConnections"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_connect"
                    app:tint="#03A9F4" />

                <TextView
                    android:id="@+id/adminDashboard_text_manageConnections"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage Connections"
                    android:textColor="#FFFFFF"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- View All Locations Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/adminDashboard_card_viewLocations"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#121212"
            app:layout_constraintTop_toBottomOf="@id/adminDashboard_card_addLocation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/adminDashboard_card_viewMap"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/adminDashboard_icon_viewLocations"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_location_list"
                    app:tint="#03A9F4" />

                <TextView
                    android:id="@+id/adminDashboard_text_viewLocations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Locations"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- View Map Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/adminDashboard_card_viewMap"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#121212"
            app:layout_constraintTop_toBottomOf="@id/adminDashboard_card_manageConnections"
            app:layout_constraintStart_toEndOf="@id/adminDashboard_card_viewLocations"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/adminDashboard_icon_viewMap"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_map_ii"
                    app:tint="#03A9F4"
                    />

                <TextView
                    android:id="@+id/adminDashboard_text_viewMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Map"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Logout Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/adminDashboard_btn_logout"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_rounded_blue"
        android:layout_marginTop="30dp"
        app:cornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/adminDashboard_cardContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
